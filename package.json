{
  "name": "sebastienbarbier",
  "version": "2.6.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "generate:site": "node scripts/generate-site-files.js",
    "prestart": "node scripts/generate-site-files.js",
    "prebuild": "node scripts/generate-site-files.js",
    "preprerender": "node scripts/generate-site-files.js",
    "optimize:images": "node scripts/optimize-images.js",
    "build": "NG_BUILD_MAX_WORKERS=1 ng run sebastienbarbier:prerender && node scripts/generate-site-files.js --dist-redirects",
    "serve": "pnpm start",
    "serve:static": "pnpm run serve:prerender",
    "test": "ng test",
    "lint": "ng lint",
    "fetch:socials": "pnpm run instagram && pnpm run nomads",
    "instagram": "node scripts/instagram.js",
    "nomads": "node scripts/nomads.js",
    "dev:ssr": "ng run sebastienbarbier:serve-ssr",
    "serve:ssr": "node dist/server/main.js",
    "build:ssr": "ng build && ng run sebastienbarbier:server",
    "prerender": "NG_BUILD_MAX_WORKERS=1 ng run sebastienbarbier:prerender && node scripts/generate-site-files.js --dist-redirects",
    "serve:prerender": "cd dist/en && http-server"
  },
  "engines": {
    "node": "24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@sentry/browser": "^10.70.0",
    "core-js": "^3.50.0",
    "country-flag-emoji": "^1.0.3",
    "express": "^5.2.1",
    "express-sslify": "^1.2.0",
    "geo-tz": "^8.1.8",
    "marked": "^18.0.10",
    "ngx-markdown": "^22.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.5",
    "@angular-eslint/builder": "^22.1.0",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/language-service": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^5.1.12",
    "@types/node": "^24.10.1",
    "angular-eslint": "^22.1.0",
    "browser-sync": "^3.0.4",
    "copy": "^0.3.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "glob-parent": "^6.0.2",
    "html-webpack-plugin": "^5.6.8",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.12.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cli": "^2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "set-value": ">=4.0.1",
    "sharp": "^0.35.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
